<Window x:Class="ProjetMenuGroup.Edition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetMenuGroup"
        mc:Ignorable="d"
        Title="Edition" Height="450" Width="800">
    <Grid Background="#FF92E0D7">
        <Label Content="Edition" HorizontalAlignment="Center" Height="36" Margin="0,61,0,0" VerticalAlignment="Top" Width="82" FontWeight="Bold" FontSize="20"/>
        <Button  x:Name="BtnMenu" Content="Menu" HorizontalAlignment="Left" Height="58" Margin="307,0,0,0" VerticalAlignment="Center" Width="199" FontWeight="Bold" Click="BtnMenu_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF4C60B3" Offset="1"/>
                    <GradientStop Color="#FF64F9EF" Offset="0.05"/>
                    <GradientStop Color="#FF4C60B3" Offset="0"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="BtnElem" Content="Element" HorizontalAlignment="Left" Height="58" Margin="511,0,0,0" VerticalAlignment="Center" Width="199" Click="BtnElem_Click" FontWeight="Bold">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF64F9EF"/>
                    <GradientStop Color="#FF4C60B3" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="BtnComp" Content="Composition" HorizontalAlignment="Left" Height="58" Margin="103,0,0,0" VerticalAlignment="Center" Width="199" FontWeight="Bold" Click="BtnComp_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF64F9EF"/>
                    <GradientStop Color="#FF4C60B3" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

    </Grid>
</Window>
